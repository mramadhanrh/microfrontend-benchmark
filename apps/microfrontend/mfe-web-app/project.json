{
  "name": "mfe-web-app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/microfrontend/mfe-web-app",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project mfe-web-app --web",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/microfrontend/mfe-web-app"
      },
      "configurations": {
        "production": {}
      }
    },
    "dev": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "dev": true,
        "port": 3000
      }
    },
    "start": {
      "executor": "@nx/next:server",
      "options": {
        "dev": false,
        "port": 3000
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "build",
        "port": 3000
      }
    }
  }
}
