{
  "name": "web-vitals-benchmark",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run index.ts",
    "lighthouse": "bun run index.ts",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.cjs",
    "lighthouse:cold": "lhci autorun --config=lighthouserc.cold.cjs",
    "lighthouse:warm": "lhci autorun --config=lighthouserc.warm.cjs",
    "lighthouse:local": "lhci autorun --config=lighthouserc.local.json",
    "lighthouse:cold:4g": "NX_NETWORK_PROFILE=4g lhci autorun --config=lighthouserc.cold.cjs",
    "lighthouse:cold:3g": "NX_NETWORK_PROFILE=3g lhci autorun --config=lighthouserc.cold.cjs",
    "lighthouse:warm:4g": "NX_NETWORK_PROFILE=4g lhci autorun --config=lighthouserc.warm.cjs",
    "lighthouse:warm:3g": "NX_NETWORK_PROFILE=3g lhci autorun --config=lighthouserc.warm.cjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@lhci/cli": "^0.13.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
